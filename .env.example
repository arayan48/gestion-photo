# Application
NODE_ENV=production
APP_URL=https://votre-domaine.com
APP_PORT=3000

# Base de données
DB_HOST=postgres
DB_PORT=5432
DB_NAME=wubalstore
DB_USER=wubalstore
DB_PASSWORD=changeme

# JWT
JWT_ACCESS_SECRET=changeme_access_secret_min_32_chars
JWT_REFRESH_SECRET=changeme_refresh_secret_min_32_chars

# Discord OAuth2
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=https://votre-domaine.com/api/auth/discord/callback

# Email (choisir un provider : brevo | smtp | resend | mailgun | sendgrid)
EMAIL_PROVIDER=brevo
EMAIL_FROM=noreply@votre-domaine.com

# Brevo
BREVO_API_KEY=

# SMTP custom
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false

# Resend
RESEND_API_KEY=

# Mailgun
MAILGUN_API_KEY=
MAILGUN_DOMAIN=

# SendGrid
SENDGRID_API_KEY=

# Backblaze B2
B2_APPLICATION_KEY_ID=
B2_APPLICATION_KEY=
B2_BUCKET_NAME=

# Stockage
STORAGE_PATH=/app/storage
