# ─────────────────────────────────────────────────────────────────────────────
# Obscura — variables d'environnement
#
# Seule l'infrastructure se configure ici. Tout le reste se règle dans l'interface :
#   • à l'installation (page /setup) : URL publique, nom de l'instance, compte Super Admin
#   • Configuration (admin) : email, Discord OAuth2, sauvegardes / Backblaze B2, stockage
# Les secrets saisis dans l'interface (clés API, mots de passe…) sont chiffrés en base
# (AES-256-GCM). Le secret de signature JWT est généré automatiquement.
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=production

# Base de données (utilisée aussi par le conteneur PostgreSQL)
DB_NAME=wubalstore
DB_USER=wubalstore
DB_PASSWORD=changeme   # générer avec : openssl rand -base64 32

# ── Optionnel ───────────────────────────────────────────────────────────────

# Clé maître de chiffrement des secrets. Si absente, elle est générée au premier
# démarrage dans le volume "backend_data" (/app/data/master.key).
# ⚠️  Sans cette clé, les secrets stockés en base sont illisibles : sauvegardez-la
#     séparément (elle n'est volontairement PAS incluse dans les sauvegardes).
# MASTER_KEY=            # générer avec : openssl rand -hex 32

# Proxys de confiance pour X-Forwarded-For (défaut : réseaux privés = Nginx dans Docker).
# TRUST_PROXY=loopback,linklocal,uniquelocal

# Déjà définis par docker-compose, à ne changer qu'en dehors de Docker :
# DB_HOST=postgres
# DB_PORT=5432
# APP_PORT=3000
# STORAGE_PATH=/app/storage
